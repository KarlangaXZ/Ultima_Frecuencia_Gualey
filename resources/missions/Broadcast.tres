[gd_resource type="Resource" script_class="MissionDefinition" format=3]
[ext_resource type="Script" path="res://scripts/missions/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://scripts/missions/mission_objective.gd" id="2"]
[sub_resource type="Resource" id="Objective0"]
script = ExtResource("2")
event_key = &"power_on"
