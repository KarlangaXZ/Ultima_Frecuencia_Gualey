[resource]
script = ExtResource("1")
id = &"supplies"
title = "Suministros para sobrevivir"
description = "La voz pide que te prepares: recupera suministros del mundo y despeja la zona. Las recogidas y bajas anteriores también cuentan."
prerequisites = Array[StringName]([&"signal"])
objectives = Array[ExtResource("2")]([SubResource("Objective0"), SubResource("Objective1"), SubResource("Objective2")])
reward_xp = 50
sequential = false
