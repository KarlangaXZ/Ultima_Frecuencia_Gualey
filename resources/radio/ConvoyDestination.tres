[gd_resource type="Resource" script_class="RadioTransmission" format=3]
[ext_resource type="Script" path="res://scripts/radio/radio_transmission.gd" id="1"]
[resource]
script = ExtResource("1")
sender = "REGISTRADOR DEL CONVOY"
messages = PackedStringArray("El autobús quedó detenido antes de abandonar el perímetro. El segundo vehículo recibió la misma corrección de ruta.", "Destino original tachado. La copia de traslado menciona una instalación de aislamiento, sin nombre público. El registro médico puede explicar la cuarentena.")
