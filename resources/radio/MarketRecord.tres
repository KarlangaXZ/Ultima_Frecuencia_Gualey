[gd_resource type="Resource" script_class="RadioTransmission" format=3]
[ext_resource type="Script" path="res://scripts/radio/radio_transmission.gd" id="1"]
[resource]
script = ExtResource("1")
sender = "REGISTRO DE EVACUACIÓN"
messages = PackedStringArray("Salimos entre los puestos al caer la noche. El punto de evacuación quedó vacío.", "Si alguien encuentra esto: buscamos la estación de comunicaciones. Todavía puede haber gente allí.")
