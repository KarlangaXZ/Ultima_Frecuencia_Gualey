[gd_resource type="Resource" script_class="RadioTransmission" format=3]
[ext_resource type="Script" path="res://scripts/radio/radio_transmission.gd" id="1"]
[resource]
script = ExtResource("1")
sender = "REGISTRO DE EVACUACIÓN"
messages = PackedStringArray("Registro de evacuación. Acceso restringido. El último convoy nunca llegó al destino asignado.", "El perímetro permanece aislado. Revisa el puesto médico, los registros y el equipo de comunicaciones.")
