extends "res://tests/market_chapter_test.gd"
## Recorrido del capítulo 3 con movimiento/física/E y tiros reales. Solo la IA
## se aísla aquí; station_chapter_state_test y station_test la mantienen activa.
const F:=preload("res://tests/station_fixture.gd")
func capture(label: String) -> void:
	if "--capture" not in OS.get_cmdline_user_args() or DisplayServer.get_name()=="headless":return
	await RenderingServer.frame_post_draw
	DirAccess.make_dir_recursive_absolute("res://test-results/phase-fourteen")
	check(root.get_texture().get_image().save_png("res://test-results/phase-fourteen/"+label+".png")==OK,"Captura "+label)
func run() -> void:
	change_scene_to_file("res://scenes/Main.tscn")
	await frames(8)
	check(await F.enter(self),"Preparación de capítulos previos y entrada a estación")
	await frames(4)
	bind_scene()
	main.get_node("SaveCoordinator").store.directory="user://tests/phase-fourteen-walk-%d-%d" % [OS.get_process_id(),int(Time.get_unix_time_from_system()*1000000)]
	check(tracker.active_chapter==ChapterCatalog.STATION and tracker.active_mission().id==&"station_records","Entrada inicia capítulo 3")
	check(not tracker.begin_chapter(ChapterCatalog.STATION),"No inicia dos veces")
	for p in main.get_node("World/ChapterPoints").get_children():
		if not p is MissionPoint:continue
		check(ZoneCatalog.point_free(ZoneCatalog.STATION,[p.position.x,p.position.y]),"Punto transitable "+p.name)
		var target: Vector2=p.position+Vector2(0,30)
		var path:=NavigationServer2D.map_get_path(player.get_world_2d().navigation_map,player.position,target,true)
		check(not path.is_empty() and path[-1].distance_to(target)<3,"Acceso navegable "+p.name)
	check(not main.get_node("World/ChapterPoints/Generator").available and not main.get_node("World/ChapterPoints/Broadcast").available,"Orden narrativo bloquea equipos")
	# Bajas auténticas antes de activar la misión final; sin eventos sintéticos.
	var enemies:=main.get_node("Zombies").get_children()
	await shoot(enemies[0])
	await shoot(enemies[1])
	check(tracker._totals.get(&"station_kills",0)==2,"Historial local antes de misión 4")
	await point("StationRadio")
	var before: int=player.get_node("ProgressionComponent").total_xp()
	await close_radio()
	check(player.get_node("ProgressionComponent").total_xp()==before,"Introducción única sin recompensa")
	await key(KEY_J)
	check(main.get_node("MissionUI").chapter.text.contains("VOCES") and player.controls_blocked,"Diario único y controles bloqueados")
	await capture("01-station-chapter-journal")
	await key(KEY_J)
	await point("Log")
	check(main.get_node("RadioUI").window.visible and player.controls_blocked,"Registro abre radio y bloquea disparos/interacción")
	var loaded: int=player.weapon.loaded
	await key(KEY_E)
	check(player.weapon.loaded==loaded,"Avanzar radio no dispara")
	main.get_node("RadioUI").close_window()
	await point("Console")
	check(main.get_node("Radio").index==1 and tracker.progress_of(&"station_records",1)==0,"Otra investigación no sobrescribe el registro pendiente")
	await point("Log")
	check(main.get_node("Radio").index==1 and main.get_node("RadioUI").window.visible,"El registro opcional también reanuda su índice")
	await close_radio()
	await point("Console")
	await point("Evacuation")
	check(tracker.state_of(&"station_records")==3 and player.get_node("ProgressionComponent").total_xp()==before+35,"Registros: 35 XP")
	var inventory: InventoryComponent=player.get_node("InventoryComponent")
	check(inventory.add_item(SaveCatalog.ITEMS.food,inventory.space_for(SaveCatalog.ITEMS.food)) and inventory.occupied_slots()==12,"Mochila llena para componente")
	var slots:=SaveCatalog.slots(inventory)
	await point("Generator")
	await point("Component")
	check(tracker.progress_of(&"station_power",1)==1 and SaveCatalog.slots(inventory)==slots,"Componente reservado sin consumir espacio")
	await point("Component")
	check(tracker._totals.get(&"station_component",0)==1,"Componente irrepetible")
	await point("Secondary")
	await close_radio()
	check(tracker.state_of(&"station_power")==3 and player.get_node("ProgressionComponent").total_xp()==before+85,"Respaldo: 50 XP")
	await point("Antenna")
	await point("Link")
	check(tracker.accepts(&"station_hidden_listen") and player.get_node("ProgressionComponent").total_xp()==before+85,"Enlace no completa lectura")
	await key(KEY_E)
	check(main.get_node("Radio").index==1,"Avanza transmisión oculta")
	await capture("02-station-hidden-signal")
	main.get_node("RadioUI").close_window()
	check(main.get_node("SaveCoordinator").save_slot(1,true).has("ok"),"Guardar transmisión oculta interrumpida")
	check(main.get_node("SaveCoordinator").load_slot(1).has("ok"),"Cargar transmisión oculta")
	await frames(5)
	bind_scene()
	check(main.get_node("Radio").index==1 and not main.get_node("RadioUI").window.visible and tracker.progress_of(&"station_power",1)==1,"Índice/componente restaurados silenciosamente")
	await point("Link")
	check(main.get_node("Radio").index==1,"Reabrir continúa sin reiniciar")
	await close_radio()
	check(tracker.state_of(&"station_frequency")==3 and player.get_node("ProgressionComponent").total_xp()==before+150,"Frecuencia: 65 XP al terminar")
	check(tracker.progress_of(&"station_call",0)==2,"Bajas previas aseguran área sin enemigos nuevos")
	await point("Broadcast")
	check(tracker.state_of(&"station_call")==2 and player.get_node("ProgressionComponent").total_xp()==before+150,"Activar final todavía no concede 90 XP")
	await key(KEY_E)
	await capture("03-station-last-call")
	main.get_node("RadioUI").close_window()
	check(main.get_node("SaveCoordinator").save_slot(2,true).has("ok"),"Guardar llamada final pendiente")
	check(main.get_node("SaveCoordinator").load_slot(2).has("ok"),"Cargar llamada final pendiente")
	await frames(5)
	bind_scene()
	await point("Broadcast")
	check(main.get_node("Radio").index==1,"Última llamada reanuda índice")
	await close_radio()
	check(tracker.chapter_completed(ChapterCatalog.STATION) and player.get_node("ProgressionComponent").total_xp()==before+240,"Capítulo 3: 240 XP exacta")
	check(main.get_node("HUD/Feedback").text.contains("Capítulo 3 completado") and not main.game_ended,"Notificación final conserva exploración")
	var awards: Dictionary=main.get_node("Missions/Rewards")._awarded
	check(awards.size()==11 and SaveCatalog.MISSIONS.slice(7,11).all(func(m):return awards.has(m.id)),"Cuatro premios individuales únicos")
	await key(KEY_J)
	check(main.get_node("MissionUI").body.text.contains("Perímetro de evacuación"),"Pista futura en diario")
	await capture("04-station-chapter-complete")
	await key(KEY_J)
	check(main.get_node("SaveCoordinator").save_slot(3,true).has("ok"),"Guardar capítulo completo")
	check(main.get_node("SaveCoordinator").load_slot(3).has("ok"),"Cargar capítulo completo")
	await frames(5)
	bind_scene()
	check(MissionSaveState.story(main).perimeter_hint and player.get_node("ProgressionComponent").total_xp()==before+240,"Pista/recompensas persisten sin duplicarse")
	await point("Broadcast")
	check(main.get_node("Radio").transmission==null and player.get_node("ProgressionComponent").total_xp()==before+240,"No se repite transmisión ni XP")
	if "--perimeter" in OS.get_cmdline_user_args():await preload("res://tests/perimeter_route.gd").run(self)
	await interact(Vector2(270,800))
	if main.get_node("ZoneManager").busy:await main.get_node("ZoneManager").transition_finished
	await frames(4)
	check(main.get_node("ZoneManager").current_zone==ZoneCatalog.MARKET,"Regreso físico a Mercado")
	await interact(Vector2(270,800))
	if main.get_node("ZoneManager").busy:await main.get_node("ZoneManager").transition_finished
	await frames(4)
	check(main.get_node("ZoneManager").current_zone==ZoneCatalog.HOME and tracker.completed_chapters().size()==3,"Regreso a Gualey conserva tres capítulos")
	if "--perimeter" in OS.get_cmdline_user_args():await walk_to(Vector2(600,800))
	check(ZoneCatalog.DEFINITIONS.size()==4 and walked>9000,"Catálogo de cuatro zonas; recorrido físico "+str(walked)+" px")
	player.health.take_damage(1000)
	check(main.game_ended and not tracker.enabled and main.get_node("Radio").transmission==null,"Game Over bloquea capítulo/radio")
	main.get_node("HUD/GameOver/Center/Panel/Margin/Content/Retry").pressed.emit()
	await frames(8)
	check(current_scene.get_node("Missions").started_chapters==[ChapterCatalog.FIRST] and not MissionSaveState.story(current_scene).perimeter_hint,"Reintentar restaura partida sin pista")
	await preload("res://tests/audio_cleanup.gd").finish(self)
	print("Resultado recorrido capítulo 3: ",checks," comprobaciones, ",failures," fallos; recorrido=",walked," px")
	quit(0 if failures==0 else 1)
